#+HTML_HEAD_EXTRA: <script>
#+HTML_HEAD_EXTRA: document.addEventListener("DOMContentLoaded", function () {
#+HTML_HEAD_EXTRA:   document.querySelectorAll("pre.src, pre.example").forEach(pre => {
#+HTML_HEAD_EXTRA:     const wrapper = document.createElement("div");
#+HTML_HEAD_EXTRA:     wrapper.className = "copy-container";
#+HTML_HEAD_EXTRA:     pre.parentNode.insertBefore(wrapper, pre);
#+HTML_HEAD_EXTRA:     wrapper.appendChild(pre);
#+HTML_HEAD_EXTRA:     const button = document.createElement("button");
#+HTML_HEAD_EXTRA:     button.className = "copy-button";
#+HTML_HEAD_EXTRA:     button.textContent = "Copy";
#+HTML_HEAD_EXTRA:     button.addEventListener("click", () => {
#+HTML_HEAD_EXTRA:       navigator.clipboard.writeText(pre.innerText).then(() => {
#+HTML_HEAD_EXTRA:         button.textContent = "Copied!";
#+HTML_HEAD_EXTRA:         setTimeout(() => button.textContent = "Copy", 2000);
#+HTML_HEAD_EXTRA:       }).catch(() => {
#+HTML_HEAD_EXTRA:         button.textContent = "Error";
#+HTML_HEAD_EXTRA:       });
#+HTML_HEAD_EXTRA:     });
#+HTML_HEAD_EXTRA:     wrapper.appendChild(button);
#+HTML_HEAD_EXTRA:   });
#+HTML_HEAD_EXTRA: });
#+HTML_HEAD_EXTRA: </script>
